# Uses the current macOS/PostgreSQL user through the local socket.
DATABASE_URL=postgresql+psycopg:///resonance

# Added in the next milestone. Never commit a real key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Keep false while sound vectors are being populated. Change to true only
# after every song has a sound_embedding.
USE_SOUND_EMBEDDINGS=false
# Experimental: only explicit lyrical requests use the stored lyrics vectors.
USE_LYRICS_EMBEDDINGS=false
# Provisional beta cutoff; calibrate with a human-judged query set.
LYRICS_MIN_SIMILARITY=0.45
AI_PROVIDER=openai
INTENT_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
