# Uses the current macOS/PostgreSQL user through the local socket.
DATABASE_URL=postgresql+psycopg:///resonance

# Added in the next milestone. Never commit a real key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Keep false while sound vectors are being populated. Change to true only
# after every song has a sound_embedding.
USE_SOUND_EMBEDDINGS=false
# Experimental: only explicit lyrical requests use the stored lyrics vectors.
USE_LYRICS_EMBEDDINGS=false
# When true, the lyrics beta searches passage vectors instead of whole-song vectors.
USE_LYRICS_CHUNKS=false
# Provisional beta cutoff; calibrate with a human-judged query set.
LYRICS_MIN_SIMILARITY=0.45
# Also remove candidates that fall far behind the best match for one query.
LYRICS_RELATIVE_MARGIN=0.05
# Limit lyrics-only results instead of padding the playlist with weak matches.
LYRICS_RESULT_LIMIT=12
# 0.65 passage evidence + 0.35 whole-song evidence by default.
LYRICS_CHUNK_WEIGHT=0.65
# Optional second-stage narrative verification. Keep false until derived
# meaning records have been populated and the per-search LLM cost is accepted.
USE_LYRICS_VERIFIER=false
LYRICS_VERIFIER_CANDIDATES=12
LYRICS_ANALYSIS_MODEL=gpt-4o-mini
LYRICS_VERIFIER_MODEL=gpt-4o-mini
AI_PROVIDER=openai
INTENT_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
